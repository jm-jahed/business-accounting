# ==============================================================================
# Business Accounting & Management System — Environment Configuration Template
# PLACEHOLDER NAMES ONLY — NEVER COMMIT REAL SECRETS TO GIT
# ==============================================================================

# Application Environment & Ports
NODE_ENV=development
PORT=5050

# Canonical Web & API URLs
WEB_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:5050
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5050

# MongoDB Database Configuration
# Default production/dev database: business_accounting
# Automated test / validation database: business_accounting_test (must end with _test)
MONGODB_URI=mongodb://127.0.0.1:27017/business_accounting?replicaSet=rs0
DB_NAME=business_accounting

# Client Authentication JWT Secrets (min 32 characters each)
JWT_ACCESS_SECRET=your-client-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-client-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Super Admin JWT Secrets (must be distinct from client secrets, min 32 chars)
ADMIN_JWT_ACCESS_SECRET=your-admin-jwt-access-secret-min-32-chars
ADMIN_JWT_REFRESH_SECRET=your-admin-jwt-refresh-secret-min-32-chars
ADMIN_JWT_ACCESS_EXPIRY=15m
ADMIN_JWT_REFRESH_EXPIRY=7d

# Super Admin TOTP AES-256-GCM Encryption Key (min 32 chars)
ADMIN_TOTP_ENCRYPTION_KEY=your-admin-totp-encryption-key-min-32-chars

# CORS Allowed Origins
CORS_ORIGINS=https://acc.webstudioae.com,http://localhost:3000,http://127.0.0.1:3000
ADMIN_CORS_ORIGINS=https://admin.acc.webstudioae.com,http://localhost:3001,http://127.0.0.1:3001

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
