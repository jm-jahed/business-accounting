# ==============================================================================
# Business Accounting & Management System — Environment Configuration Template
# PLACEHOLDER VALUES ONLY — DO NOT COMMIT REAL CREDENTIALS TO GIT
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5050

# Canonical Production & Staging Domains
WEB_APP_URL=https://acc.webstudioae.com
API_BASE_URL=https://api-acc.webstudioae.com

# Client-side Public Environment Variables (Next.js)
NEXT_PUBLIC_APP_URL=https://acc.webstudioae.com
NEXT_PUBLIC_API_URL=https://api-acc.webstudioae.com

# Database Connection (MongoDB)
# Example: mongodb://<db_user>:<db_password>@127.0.0.1:27017/business_accounting?authSource=admin&replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/business_accounting?replicaSet=rs0
DB_NAME=business_accounting

# Security & Authentication
JWT_ACCESS_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=replace-with-a-different-secure-random-secret-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://acc.webstudioae.com,http://localhost:3000,http://127.0.0.1:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
